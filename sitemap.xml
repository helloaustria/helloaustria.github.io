---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign listed = "" -%}
{%- for item in site.pages -%}
{%- if item.sitemap != false and item.title and item.url != "/sitemap.xml" -%}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
    {%- if item.last_updated -%}
    <lastmod>{{ item.last_updated }}</lastmod>
    {%- endif -%}
    <changefreq>{% if item.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if item.url == "/" %}1.0{% elsif item.article %}0.8{% else %}0.5{% endif %}</priority>
  </url>
{%- endif -%}
{%- endfor -%}
</urlset>
